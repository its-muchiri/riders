# Database
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=rider_co_ke
DB_USER=rider_app
DB_PASSWORD=

# M-Pesa Daraja
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_URL=https://rider.co.ke/api/v1/payments/mpesa/callback
# Shared secret appended to every callback URL as ?token=<secret> (Daraja callbacks are unsigned).
# When set, callbacks without it are rejected. e.g. MPESA_CALLBACK_URL=https://rider.co.ke/api/v1/payments/mpesa/callback?token=<secret>
MPESA_CALLBACK_SECRET=
# B2C rider payouts (leave blank to keep payouts as pending ledger rows for a manual/batch run)
MPESA_INITIATOR_NAME=
MPESA_SECURITY_CREDENTIAL=
MPESA_B2C_RESULT_URL=https://rider.co.ke/api/v1/payments/mpesa/b2c-result
MPESA_B2C_TIMEOUT_URL=https://rider.co.ke/api/v1/payments/mpesa/b2c-timeout
# Override the Daraja host (tests only — points at tests/support/mock_daraja.php). Never set in production.
MPESA_BASE_URL=

# Card gateway
CARD_GATEWAY_PUBLIC_KEY=
CARD_GATEWAY_SECRET_KEY=

# Geolocation provider (see shared-architecture.md)
MAPS_PROVIDER_API_KEY=

# App
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8000
